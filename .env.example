# Copy this file to .env and fill in real values.
# Never commit .env to version control.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=botebank
DB_CHARSET=utf8mb4

# Set to 'true' only when serving the application over HTTPS.
SESSION_SECURE=false

# SMS gateway credentials (loaded by includes/sms_notifications.php).
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# API key required by sms/function/sms.php. Keep it long and random.
SMS_API_KEY=
